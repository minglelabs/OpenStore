generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Developer {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  headline     String
  description  String
  website      String?
  verified     Boolean  @default(false)
  region       String
  supportEmail String?
  metadata     Json?
  apps         App[]
  taxProfile   DeveloperTaxProfile?
  payoutProfile PayoutProfile?
  contractVersions DeveloperContractVersion[]
  products     Product[]
  orders       CommerceOrder[]
  subscriptions CommerceSubscription[]
  payouts      DeveloperPayout[]
  reserveHolds ReserveHold[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  summary     String
  metadata    Json?
  apps        App[]
  collections Collection[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model App {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  tagline         String
  summary         String
  description     String
  priceLabel      String
  ratingAverage   Float            @default(0)
  ratingCount     Int              @default(0)
  downloadCount   Int              @default(0)
  ageRating       String
  sizeLabel       String
  metadata        Json?
  developerId     String
  categoryId      String
  developer       Developer        @relation(fields: [developerId], references: [id], onDelete: Cascade)
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  versions        AppVersion[]
  collectionItems CollectionItem[]
  reviews         Review[]
  libraryEntries  LibraryEntry[]
  products        Product[]
  orders          CommerceOrder[]
  entitlements    Entitlement[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model AppVersion {
  id           String   @id @default(cuid())
  appId        String
  version      String
  releaseNotes String
  releasedAt   DateTime
  app          App      @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, releasedAt])
}

model Collection {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String
  curator     String
  metadata    Json?
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items       CollectionItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  appId        String
  position     Int
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  app          App        @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([collectionId, appId])
  @@unique([collectionId, position])
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String
  region         String
  metadata       Json?
  libraryEntries LibraryEntry[]
  devices        Device[]
  reviews        Review[]
  orders         CommerceOrder[]
  paymentInstrumentRefs PaymentInstrumentRef[]
  subscriptions  CommerceSubscription[]
  entitlements   Entitlement[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model LibraryEntry {
  id        String        @id @default(cuid())
  userId    String
  appId     String
  status    LibraryStatus
  version   String?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  app       App           @relation(fields: [appId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, appId])
}

model Review {
  id          String   @id @default(cuid())
  appId       String
  userId      String
  title       String
  body        String
  rating      Int
  submittedAt DateTime @default(now())
  app         App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([appId, submittedAt])
}

model Device {
  id         String   @id @default(cuid())
  userId     String
  name       String
  platform   String
  trusted    Boolean  @default(false)
  lastSeenAt DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum LibraryStatus {
  INSTALLED
  UPDATE_AVAILABLE
  QUEUED
  WISHLISTED
}

model MerchantEntity {
  id                  String            @id @default(cuid())
  code                String            @unique
  legalName           String
  homeCountryCode     String
  defaultCurrencyCode String
  active              Boolean           @default(true)
  storefrontRegions   StorefrontRegion[]
  merchantAccounts    MerchantAccount[]
  routes              PspRoute[]
  orders              CommerceOrder[]
  settlementBatches   SettlementBatch[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model StorefrontRegion {
  id              String                  @id @default(cuid())
  countryCode     String                  @unique
  currencyCode    String
  languageCode    String
  taxMode         TaxMode
  defaultEntityId String
  defaultEntity   MerchantEntity          @relation(fields: [defaultEntityId], references: [id], onDelete: Restrict)
  consumerContracts ConsumerContractVersion[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
}

model MerchantAccount {
  id                    String          @id @default(cuid())
  key                   String          @unique
  entityId              String
  provider              PaymentProvider
  lane                  CommerceLane
  displayName           String
  settlementCurrencyCode String
  settlementCountryCode String
  externalReference     String?         @unique
  allowsRecurring       Boolean         @default(true)
  active                Boolean         @default(true)
  entity                MerchantEntity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  routes                PspRoute[]
  orders                CommerceOrder[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([entityId, provider, lane])
}

model PspRoute {
  id                      String              @id @default(cuid())
  key                     String              @unique
  entityId                String
  merchantAccountId       String
  provider                PaymentProvider
  lane                    CommerceLane
  countryCode             String
  currencyCode            String
  priority                Int                 @default(100)
  status                  RouteStatus         @default(ACTIVE)
  paymentMethods          PaymentMethodType[]
  recurringPaymentMethods PaymentMethodType[]
  supportedProductTypes   ProductType[]
  entity                  MerchantEntity      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  merchantAccount         MerchantAccount     @relation(fields: [merchantAccountId], references: [id], onDelete: Cascade)
  orders                  CommerceOrder[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([lane, countryCode, currencyCode, status, priority])
}

model ConsumerContractVersion {
  id                String          @id @default(cuid())
  storefrontRegionId String
  lane              CommerceLane
  version           String
  status            ContractStatus  @default(DRAFT)
  documentUrl       String
  effectiveAt       DateTime
  retiredAt         DateTime?
  storefrontRegion  StorefrontRegion @relation(fields: [storefrontRegionId], references: [id], onDelete: Cascade)
  orders            CommerceOrder[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([storefrontRegionId, lane, version])
}

model DeveloperContractVersion {
  id              String           @id @default(cuid())
  developerId     String?
  version         String
  status          ContractStatus   @default(DRAFT)
  revenueShareBps Int
  reserveBps      Int              @default(0)
  agreementUrl    String?
  effectiveAt     DateTime
  retiredAt       DateTime?
  developer       Developer?       @relation(fields: [developerId], references: [id], onDelete: SetNull)
  orders          CommerceOrder[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([developerId, version])
}

model DeveloperTaxProfile {
  id                     String           @id @default(cuid())
  developerId            String           @unique
  taxResidencyCountryCode String
  defaultCurrencyCode    String
  vatId                  String?
  withholdingRateBps     Int              @default(0)
  complianceStatus       ComplianceStatus @default(PENDING)
  metadata               Json?
  developer              Developer        @relation(fields: [developerId], references: [id], onDelete: Cascade)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

model PayoutProfile {
  id                    String              @id @default(cuid())
  developerId           String              @unique
  provider              PaymentProvider
  payoutCurrencyCode    String
  destinationCountryCode String
  externalDestinationRef String?            @unique
  status                PayoutProfileStatus @default(PENDING)
  minimumPayoutAmount   Decimal             @default(0) @db.Decimal(18, 2)
  metadata              Json?
  developer             Developer           @relation(fields: [developerId], references: [id], onDelete: Cascade)
  payouts               DeveloperPayout[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model Product {
  id             String                @id @default(cuid())
  key            String                @unique
  appId          String?
  developerId    String
  type           ProductType
  name           String
  description    String?
  billingPeriod  String?
  entitlementKey String
  active         Boolean               @default(true)
  metadata       Json?
  app            App?                  @relation(fields: [appId], references: [id], onDelete: SetNull)
  developer      Developer             @relation(fields: [developerId], references: [id], onDelete: Cascade)
  prices         ProductPrice[]
  offers         Offer[]
  orders         CommerceOrder[]
  subscriptions  CommerceSubscription[]
  entitlements   Entitlement[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model PriceBook {
  id           String        @id @default(cuid())
  key          String        @unique
  countryCode  String
  currencyCode String
  active       Boolean       @default(true)
  startsAt     DateTime
  endsAt       DateTime?
  prices       ProductPrice[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([countryCode, currencyCode, active])
}

model ProductPrice {
  id              String               @id @default(cuid())
  productId       String
  priceBookId     String
  unitAmount      Decimal              @db.Decimal(18, 2)
  trialDays       Int?
  billingInterval String?
  taxBehavior     String?
  product         Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceBook       PriceBook            @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  schedules       SubscriptionSchedule[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([productId, priceBookId])
}

model Offer {
  id          String    @id @default(cuid())
  productId   String
  code        String
  name        String
  offerType   String
  startsAt    DateTime
  endsAt      DateTime?
  trialDays   Int?
  discountBps Int?
  metadata    Json?
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([productId, code])
}

model CommerceOrder {
  id                         String                    @id @default(cuid())
  orderNumber                String                    @unique
  userId                     String
  appId                      String?
  productId                  String?
  developerId                String?
  lane                       CommerceLane
  status                     OrderStatus               @default(DRAFT)
  countryCode                String
  currencyCode               String
  merchantEntityId           String
  merchantAccountId          String
  pspRouteId                 String
  consumerContractVersionId  String
  developerContractVersionId String?
  taxMode                    TaxMode
  grossAmount                Decimal                   @db.Decimal(18, 2)
  taxAmount                  Decimal                   @default(0) @db.Decimal(18, 2)
  developerAmount            Decimal                   @default(0) @db.Decimal(18, 2)
  reserveAmount              Decimal                   @default(0) @db.Decimal(18, 2)
  platformFeeAmount          Decimal                   @default(0) @db.Decimal(18, 2)
  refundedAmount             Decimal                   @default(0) @db.Decimal(18, 2)
  contractSnapshot           Json
  user                       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  app                        App?                      @relation(fields: [appId], references: [id], onDelete: SetNull)
  product                    Product?                  @relation(fields: [productId], references: [id], onDelete: SetNull)
  developer                  Developer?                @relation(fields: [developerId], references: [id], onDelete: SetNull)
  merchantEntity             MerchantEntity            @relation(fields: [merchantEntityId], references: [id], onDelete: Restrict)
  merchantAccount            MerchantAccount           @relation(fields: [merchantAccountId], references: [id], onDelete: Restrict)
  pspRoute                   PspRoute                  @relation(fields: [pspRouteId], references: [id], onDelete: Restrict)
  consumerContractVersion    ConsumerContractVersion   @relation(fields: [consumerContractVersionId], references: [id], onDelete: Restrict)
  developerContractVersion   DeveloperContractVersion? @relation(fields: [developerContractVersionId], references: [id], onDelete: SetNull)
  invoices                   Invoice[]
  paymentAttempts            PaymentAttempt[]
  entitlements               Entitlement[]
  refunds                    RefundCase[]
  disputes                   DisputeCase[]
  ledgerEntries              LedgerEntry[]
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  @@index([userId, status, createdAt])
  @@index([merchantEntityId, countryCode, currencyCode])
}

model Invoice {
  id                     String                @id @default(cuid())
  invoiceNumber          String                @unique
  orderId                String?
  subscriptionId         String?
  status                 InvoiceStatus         @default(DRAFT)
  currencyCode           String
  subtotalAmount         Decimal               @db.Decimal(18, 2)
  taxAmount              Decimal               @default(0) @db.Decimal(18, 2)
  totalAmount            Decimal               @db.Decimal(18, 2)
  dueAt                  DateTime?
  paidAt                 DateTime?
  metadata               Json?
  order                  CommerceOrder?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subscription           CommerceSubscription? @relation("SubscriptionInvoices", fields: [subscriptionId], references: [id], onDelete: SetNull)
  paymentAttempts        PaymentAttempt[]
  ledgerEntries          LedgerEntry[]
  currentForSubscription CommerceSubscription? @relation("SubscriptionCurrentInvoice")
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([subscriptionId, status, dueAt])
}

model PaymentInstrumentRef {
  id                       String              @id @default(cuid())
  userId                   String
  provider                 PaymentProvider
  type                     PaymentInstrumentType
  usageScope               PaymentUsageScope
  externalCustomerRef      String?
  externalPaymentMethodRef String
  countryCode              String?
  brand                    String?
  last4                    String?
  expiresAt                DateTime?
  user                     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  mandates                 MandateRef[]
  paymentAttempts          PaymentAttempt[]
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@unique([provider, externalPaymentMethodRef])
  @@index([userId, provider])
}

model MandateRef {
  id                String                 @id @default(cuid())
  paymentInstrumentId String
  provider          PaymentProvider
  externalMandateRef String                @unique
  status            MandateStatus          @default(ACTIVE)
  usageScope        PaymentUsageScope
  acceptedAt        DateTime
  countryCode       String?
  paymentInstrument PaymentInstrumentRef   @relation(fields: [paymentInstrumentId], references: [id], onDelete: Cascade)
  paymentAttempts   PaymentAttempt[]
  subscriptions     CommerceSubscription[] @relation("SubscriptionCurrentMandate")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model PaymentAttempt {
  id                  String                 @id @default(cuid())
  orderId             String?
  invoiceId           String?
  paymentInstrumentId String?
  mandateId           String?
  provider            PaymentProvider
  status              PaymentAttemptStatus   @default(CREATED)
  paymentMethodType   PaymentMethodType
  isRecurring         Boolean                @default(false)
  amount              Decimal                @db.Decimal(18, 2)
  currencyCode        String
  externalPaymentRef  String?
  externalChargeRef   String?
  externalCustomerRef String?
  failureCode         String?
  failureMessage      String?
  authorizedAt        DateTime?
  capturedAt          DateTime?
  order               CommerceOrder?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoice             Invoice?               @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentInstrument   PaymentInstrumentRef?  @relation(fields: [paymentInstrumentId], references: [id], onDelete: SetNull)
  mandate             MandateRef?            @relation(fields: [mandateId], references: [id], onDelete: SetNull)
  ledgerEntries       LedgerEntry[]
  refunds             RefundCase[]
  disputes            DisputeCase[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([orderId, status, createdAt])
  @@index([invoiceId, status, createdAt])
}

model CommerceSubscription {
  id                  String                 @id @default(cuid())
  userId              String
  productId           String
  developerId         String?
  currentInvoiceId    String?                @unique
  currentMandateId    String?
  status              SubscriptionStatus     @default(DRAFT)
  billingCurrencyCode String
  billingCountryCode  String
  startedAt           DateTime?
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean                @default(false)
  canceledAt          DateTime?
  endedAt             DateTime?
  routeSnapshot       Json
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  product             Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  developer           Developer?             @relation(fields: [developerId], references: [id], onDelete: SetNull)
  currentInvoice      Invoice?               @relation("SubscriptionCurrentInvoice", fields: [currentInvoiceId], references: [id], onDelete: SetNull)
  currentMandate      MandateRef?            @relation("SubscriptionCurrentMandate", fields: [currentMandateId], references: [id], onDelete: SetNull)
  invoices            Invoice[]              @relation("SubscriptionInvoices")
  schedules           SubscriptionSchedule[]
  entitlements        Entitlement[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([userId, status, currentPeriodEnd])
}

model SubscriptionSchedule {
  id          String                @id @default(cuid())
  subscriptionId String
  phaseName   String
  startsAt    DateTime
  endsAt      DateTime?
  priceId     String?
  autoRenews  Boolean               @default(true)
  quantity    Int                   @default(1)
  metadata    Json?
  subscription CommerceSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  price       ProductPrice?         @relation(fields: [priceId], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model LedgerEntry {
  id                String           @id @default(cuid())
  orderId           String?
  invoiceId         String?
  paymentAttemptId  String?
  refundCaseId      String?
  disputeCaseId     String?
  payoutId          String?
  settlementBatchId String?
  entryType         LedgerEntryType
  accountCode       String
  direction         LedgerDirection
  amount            Decimal          @db.Decimal(18, 2)
  currencyCode      String
  occurredAt        DateTime
  eventKey          String           @unique
  metadata          Json?
  order             CommerceOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoice           Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentAttempt    PaymentAttempt?  @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  refundCase        RefundCase?      @relation(fields: [refundCaseId], references: [id], onDelete: SetNull)
  disputeCase       DisputeCase?     @relation(fields: [disputeCaseId], references: [id], onDelete: SetNull)
  payout            DeveloperPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  settlementBatch   SettlementBatch? @relation(fields: [settlementBatchId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())

  @@index([occurredAt, entryType])
  @@index([orderId, invoiceId])
}

model Entitlement {
  id             String                 @id @default(cuid())
  userId         String
  appId          String?
  productId      String?
  orderId        String?
  subscriptionId String?
  status         EntitlementStatus      @default(PENDING)
  entitlementKey String
  startsAt       DateTime
  endsAt         DateTime?
  revokedAt      DateTime?
  sourceType     String
  metadata       Json?
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  app            App?                   @relation(fields: [appId], references: [id], onDelete: SetNull)
  product        Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  order          CommerceOrder?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subscription   CommerceSubscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([userId, entitlementKey, status])
}

model SettlementBatch {
  id                  String           @id @default(cuid())
  batchNumber         String           @unique
  merchantEntityId    String
  currencyCode        String
  periodStart         DateTime
  periodEnd           DateTime
  status              SettlementBatchStatus @default(DRAFT)
  totalDeveloperAmount Decimal         @default(0) @db.Decimal(18, 2)
  totalReserveAmount  Decimal          @default(0) @db.Decimal(18, 2)
  totalPayoutAmount   Decimal          @default(0) @db.Decimal(18, 2)
  merchantEntity      MerchantEntity   @relation(fields: [merchantEntityId], references: [id], onDelete: Restrict)
  payouts             DeveloperPayout[]
  ledgerEntries       LedgerEntry[]
  reserveHolds        ReserveHold[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model DeveloperPayout {
  id                 String          @id @default(cuid())
  settlementBatchId  String
  developerId        String
  payoutProfileId    String
  status             PayoutStatus    @default(PENDING)
  currencyCode       String
  grossAmount        Decimal         @db.Decimal(18, 2)
  reserveHeldAmount  Decimal         @default(0) @db.Decimal(18, 2)
  netAmount          Decimal         @db.Decimal(18, 2)
  externalPayoutRef  String?
  issuedAt           DateTime?
  paidAt             DateTime?
  settlementBatch    SettlementBatch @relation(fields: [settlementBatchId], references: [id], onDelete: Cascade)
  developer          Developer       @relation(fields: [developerId], references: [id], onDelete: Cascade)
  payoutProfile      PayoutProfile   @relation(fields: [payoutProfileId], references: [id], onDelete: Restrict)
  ledgerEntries      LedgerEntry[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([developerId, status, paidAt])
}

model RefundCase {
  id                String          @id @default(cuid())
  orderId           String
  paymentAttemptId  String?
  status            RefundStatus    @default(OPEN)
  reason            String
  amount            Decimal         @db.Decimal(18, 2)
  currencyCode      String
  externalRefundRef String?
  openedAt          DateTime        @default(now())
  resolvedAt        DateTime?
  order             CommerceOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentAttempt    PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  ledgerEntries     LedgerEntry[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model DisputeCase {
  id                 String          @id @default(cuid())
  orderId            String
  paymentAttemptId   String
  status             DisputeStatus   @default(OPEN)
  reason             String
  amount             Decimal         @db.Decimal(18, 2)
  currencyCode       String
  externalDisputeRef String?
  openedAt           DateTime        @default(now())
  dueAt              DateTime?
  resolvedAt         DateTime?
  order              CommerceOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentAttempt     PaymentAttempt  @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  ledgerEntries      LedgerEntry[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model ReserveHold {
  id                String           @id @default(cuid())
  developerId       String
  settlementBatchId String?
  currencyCode      String
  amount            Decimal          @db.Decimal(18, 2)
  reason            String
  releasedAt        DateTime?
  developer         Developer        @relation(fields: [developerId], references: [id], onDelete: Cascade)
  settlementBatch   SettlementBatch? @relation(fields: [settlementBatchId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

enum CommerceLane {
  MARKETPLACE
  MERCHANT_OF_RECORD
}

enum PaymentProvider {
  STRIPE
  ADYEN
  PADDLE
}

enum TaxMode {
  PSP_NATIVE
  DEDICATED_ENGINE
  MANUAL
}

enum RouteStatus {
  ACTIVE
  INACTIVE
}

enum ContractStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ComplianceStatus {
  PENDING
  VERIFIED
  RESTRICTED
}

enum PayoutProfileStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ProductType {
  PAID_APP
  CONSUMABLE_IAP
  NON_CONSUMABLE_IAP
  AUTO_RENEWING_SUBSCRIPTION
}

enum OrderStatus {
  DRAFT
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELED
  CHARGEBACK
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
  FAILED
}

enum PaymentMethodType {
  STORE_BALANCE
